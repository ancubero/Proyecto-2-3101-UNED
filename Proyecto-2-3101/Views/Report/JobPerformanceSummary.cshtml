@using Proyecto_2_3101.Extensions
@model Proyecto_2_3101.Models.ViewModels.JobPerformanceReportViewModel

@{
    ViewBag.Title = "Rendimiento y Demanda de Servicios";
}

<div class="border-bottom pb-2 mb-4">
    <h2><i class="bi bi-star-fill text-warning"></i> @ViewBag.Title</h2>
</div>

<!-- --- TOP-PERFORMING INSIGHT FLAGS --- -->
<div class="row g-3 mb-4">
    @if (Model.MostRequestedJob != null)
    {
        <div class="col-md-12">
            <div class="card border-0 bg-light shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-warning text-dark p-3 rounded-circle me-3">
                        <i class="bi bi-trophy-fill fs-2"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase small m-0 fw-bold">Servicio Más Solicitado (#1 Más
                            Vendido)</h6>
                        <h3 class="text-primary fw-bold my-1">@Model.MostRequestedJob.JobTypeName</h3>
                        <p class="m-0 text-muted">
                            Solicitado un total de <strong
                                class="text-dark">@Model.MostRequestedJob.RequestCount veces</strong>,
                            generando un acumulado bruto de <strong
                                class="text-success">@Model.MostRequestedJob.RevenueGenerated.FormatColones()</strong>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- --- 1. PERFORMANCE SUMMARY DATA TABLE --- -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-header bg-dark text-white fw-bold py-3">
        <i class="bi bi-list-ol"></i> Catálogo de Servicios Ordenado por Nivel de Demanda
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-striped align-middle m-0">
            <thead class="table-light">
            <tr>
                <th class="ps-4" style="width: 40%;">Nombre del Servicio</th>
                <th class="text-center" style="width: 20%;">Frecuencia (Veces Solicitado)</th>
                <th class="text-center" style="width: 20%;">Participación (%)</th>
                <th class="text-end pe-4" style="width: 20%;">Ingresos Totales Generados</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.JobStatistics == null || !Model.JobStatistics.Any())
            {
                <tr>
                    <td colspan="4" class="text-center py-4 text-muted">
                        <i class="bi bi-info-circle-fill"></i> No hay datos de lavados registrados para computar
                        estadísticas.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.JobStatistics)
                {
                    double sharePercentage = Model.GrandTotalServicesRendered > 0
                        ? ((double)item.RequestCount / Model.GrandTotalServicesRendered) * 100
                        : 0;

                    <tr>
                        <td class="ps-4 fw-semibold text-dark">
                            <i class="bi bi-tag-fill text-muted me-2"></i> @item.JobTypeName
                        </td>
                        <td class="text-center fs-5 fw-bold text-primary">@item.RequestCount</td>
                        <td class="text-center fw-semibold text-muted">@sharePercentage.ToString("F1")%</td>
                        <td class="text-end pe-4 fw-bold text-success">@item.RevenueGenerated.FormatColones()</td>
                    </tr>
                }

                <!-- SUMMARY TOTAL FOOTER ROW -->
                <tr class="table-dark text-white fw-bold">
                    <td class="ps-4">VOLUMEN TOTAL ACUMULADO:</td>
                    <td class="text-center fs-4 text-warning">@Model.GrandTotalServicesRendered</td>
                    <td class="text-center">100%</td>
                    <td class="text-end pe-4 fs-4 text-success">@Model.GrandTotalRevenueGenerated.FormatColones()</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- --- 2. THE DEMAND GRAPHIC BAR CONTAINER (Under the Table) --- -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white fw-bold py-3">
        <i class="bi bi-bar-chart-fill"></i> Comparativa Gráfica de Frecuencia de Demanda
    </div>
    <div class="card-body">
        <div style="position: relative; height:320px; width:100%;">
            @if (Model.JobStatistics != null && Model.JobStatistics.Any())
            {
                <canvas id="jobPerformanceChart" style="display: block; width: 100%; height: 100%;"></canvas>
            }
            else
            {
                <div class="text-center py-5 text-muted">Gráfico no disponible.</div>
            }
        </div>
    </div>
</div>

@section Scripts
{
    <!-- --- CHART INFRASTRUCTURE CORE ASSETS --- -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        window.addEventListener('DOMContentLoaded', function () {
            try {
                const canvasNode = document.getElementById('jobPerformanceChart');
                if (!canvasNode) return;

                const serviceLabels = [];
                const requestCounts = [];

                // Populate your script arrays cleanly from the C# loop using a <text> block
                @foreach (var item in Model.JobStatistics!)
                {
                    <text>
                        serviceLabels.push("@item.JobTypeName");
                        requestCounts.push(@item.RequestCount);
                    </text>
                }

                const ctx = canvasNode.getContext('2d');

                new Chart(ctx, {
                    type: 'bar', // A bar chart displays distinct catalog comparisons beautifully
                    data: {
                        labels: serviceLabels,
                        datasets: [{
                            label: 'Veces Solicitado',
                            data: requestCounts,
                            backgroundColor: 'rgba(13, 110, 253, 0.75)', // Elegant corporate blue
                            borderColor: 'rgb(13, 110, 253)',
                            borderWidth: 2,
                            borderRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {display: false}
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0, // Forces clean, whole integer counts (no partial washes!)
                                    stepSize: 1
                                }
                            }
                        }
                    }
                });
                console.log("Job performance graphics system initiated successfully.");
            } catch (err) {
                console.error("Graphics Engine Crash: ", err);
            }
        });
    </script>
}
