@using Proyecto_2_3101.Extensions
@model IEnumerable<UserModel>
@{
    ViewBag.Title = "Lista de Usuarios"; 
}

<h2>@ViewBag.Title</h2>
<div class="text-end">
    <a href="@Url.Action("Add", "User")" class="btn btn-primary"><i class="bi bi-person-fill-add"></i>Crear
        Usuario</a>
</div>
@if (TempData["message"] != null)
{
    <div id="alert" class="alert alert-success my-3 alert-dismissible fade show" role="alert">
        @TempData["message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<table class="table table-striped">
    <thead>
    <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Usuario</th>
        <th>Fecha Creación</th>
        <th>Fecha Modificación</th>
        <th>Acción</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.UserId</td>
            <td>@user.FullName</td>
            <td>@user.Username</td>
            <td>@user.CreationDate.FormatDate()</td>
            <td>@user.ModifyDate.FormatDate()</td>
            <td>
                <a href="@Url.Action("Edit", "User", new { id = @user.UserId })" class="btn btn-outline-secondary">
                    <i class="bi bi-pencil-square"></i> Editar
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts
{
    @if (TempData["message"] != null)
    {
        <script>
            $(document).ready(function () {
                setTimeout(function () {
                    bootstrap.Alert.getOrCreateInstance($('#alert')[0]).close();
                }, 3000); // 3000 milliseconds = 3 seconds
            });

        </script>
    }
}