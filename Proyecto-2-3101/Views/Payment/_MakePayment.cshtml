@using Proyecto_2_3101.Extensions
@using Proyecto_2_3101.Models.Enums
@model OrderModel
<div id="orderInformation">
    <div class="row bg-light p-1">
        <div class="col-md-4">Cliente</div>
        <div class="col-md-8">@Model.Client!.Fullname</div>
    </div>
    <div class="row bg-light p-1">
        <div class="col-md-4">Placa</div>
        <div class="col-md-8">@Model.Vehicle!.PlateNumber</div>
    </div>
    <div class="row bg-light p-1">
        <div class="col-md-4">Marca</div>
        <div class="col-md-8">@Model.Vehicle.Brand</div>
    </div>
    <div class="row bg-light p-1">
        <div class="col-md-4">Modelo</div>
        <div class="col-md-8">@Model.Vehicle.Model</div>
    </div>
    <div class="row bg-light p-1">
        <div class="col-md-4">Servicios</div>
        <div class="col-md-8">
            <ul>
                @foreach (var job in Model.JobOrders)
                {
                    <li>@job.JobType.Name</li>
                }
            </ul>
        </div>
    </div>
    <div class="row bg-light p-1">
        <div class="col-md-4">Total</div>
        <div class="col-md-8">@Model.TotalPrice.FormatColones()</div>
    </div>
    <div class="row bg-light p-1">
        <div class="col-md-4">Estado actual</div>
        <div class="col-md-8">
        <span class="badge @Model.OrderStatus.ToBadgeColor() p-2">
            @Html.DisplayFor(o => Model.OrderStatus)
        </span>
        </div>
    </div>
    <form id="paymentForm" method="post" action="@Url.Action("MakePayment", "Payment")" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger" id="validationSummary">
            Por favor corrija los siguientes errores:
        </div>
        <input type="hidden" name="orderId" value="@Model.Id"/>
        <div class="row bg-light p-1">
            <div class="col-md-12"><strong>Metodos de Pago</strong></div>
            <div class="col-md-12">
                @foreach (var payMethod in Html.GetEnumSelectList<PaymentMethods>())
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" value="@payMethod.Value" name="payment"
                               id="payment_@payMethod.Value" required>
                        <label class="form-check-label" for="payment_@payMethod.Value">
                            @payMethod.Text
                        </label>
                    </div>
                }
            </div>
        </div>
        <div class="mt-3 text-center">
            <button type="submit" class="btn btn-secondary px-5 py-2">
                <i class="bi bi-arrow-right-circle-fill"></i> Realizar Pago
            </button>
        </div>
    </form>
</div>
<script>
    $(document).ready(function () {
        $("#paymentForm").on("submit", function (e) {
            e.preventDefault();
            const validationSummary = $("#validationSummary");
            validationSummary.addClass("validation-summary-valid").removeClass("show");

            if (!$("input[name='payment']:checked").val()) {
                validationSummary.html(`
                <i class="bi bi-exclamation-triangle-fill"></i> 
                <strong>Error:</strong> Debe seleccionar al menos un método de pago antes de continuar.
            `)
                validationSummary.addClass("show").removeClass("validation-summary-valid");

                return false;
            }

            const formData = $(this).serialize();
            $.ajax({
                url: '@Url.Action("MakePayment", "Payment")',
                type: "POST",
                data: formData,
                cache: false
            }).done(function (result) {
                $("#orderInformation").html(result);
            });
        });
    });
</script>