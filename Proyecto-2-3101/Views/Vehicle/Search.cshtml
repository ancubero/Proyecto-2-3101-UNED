@{
    ViewBag.Title = "Buscar Vehículo";
}
<h2>@ViewBag.Title</h2>
<div class="row">
    <div class="offset-md-4 col-md-4">
        <form method="post">
            <div class="form-floating mb-3">
                <input name="search" id="search" class="form-control" placeholder="Vehículo" />
                <label for="search">Buscar Vehículo</label>
            </div>
            <button id="btnSearch" class="btn btn-outline-success w-100 py-2" type="button"><i class="bi bi-search"></i> Buscar</button>
        </form>
    </div>
</div>
<div id="searchResult" class="mt-3"></div>

<div id="alertNotFound" class="alert alert-info my-3 alert-dismissible fade" role="alert">
    <span></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<div id="alertError" class="alert alert-danger my-3 alert-dismissible fade" role="alert">
    <span></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>


@section Scripts 
{
    <script>
    $(document).ready(function () {
        $("#btnSearch").click(function (e) {
            e.preventDefault();
            const plateNumber = $("#search").val();
            $("#alertError").removeClass("show");
            $("#alertNotFound").removeClass("show");
            $.ajax({
                url: '@Url.Action("Search", "Vehicle", new { plateNumber = "PLACEHOLDER"})'.replace("PLACEHOLDER", plateNumber),
                type: "POST",
                cache: false
            }).done(function (result) {
                $("#searchResult").html(result);
            }).fail(function (xhr) {
                let statusCode = xhr.status;
                let statusMessage = xhr.responseText;
                
                if(statusCode === 400) {
                    $("#alertError span").text(statusMessage);
                    $("#alertError").addClass("show");
                }

                if(statusCode === 404) {
                    $("#alertNotFound span").text(statusMessage);
                    $("#alertNotFound").addClass("show");
                }
            });
        });
    });
</script>
}

