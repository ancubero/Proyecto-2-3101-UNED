@using Proyecto_2_3101.Extensions
@model JobTypeModel
@{
    var crCulture = new System.Globalization.CultureInfo("es-CR");
}

<div class="row bg-light p-1">
    <div class="col-md-4">Nombre</div>
    <div class="col-md-8">@Model.Name</div>
</div>
<div class="row bg-light p-1">
    <div class="col-md-4">Precio</div>
    <div class="col-md-8">@Model.Price.ToString("C", crCulture)</div>
</div>
<div class="row bg-light p-1">
    <div class="col-md-4">Duración</div>
    <div class="col-md-8">@Model.DurationMinutes</div>
</div>
<div class="row bg-light p-1">
    <div class="col-md-4">Estado</div>
    <div class="col-md-8">
        <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
            @(Model.IsActive ? "Activo" : "Inactivo")
        </span>
    </div>
</div>
<div class="row bg-light p-1">
    <div class="col-md-12">Descripción</div>
    <div class="col-md-12">@Model.Description</div>
</div>
<div class="row bg-light p-1">
    <div class="col-md-4">Creado por</div>
    <div class="col-md-8">@Model.CreatedByUser!.Username.ToUpper() el @Model.CreatedAt.FormatDate()</div>
</div>
<div class="row bg-light p-1">
    <div class="col-md-4">Modificado por</div>
    <div class="col-md-8">
        @if(Model.UpdatedByUser != null)
        {
            <text>@Model.UpdatedByUser!.Username.ToUpper() el @Model.UpdatedAt.FormatDate()</text>
        }
        else
        {
            <text>---</text>
        }
    </div>
</div>