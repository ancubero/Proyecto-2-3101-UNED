@using Microsoft.AspNetCore.Http
@using Proyecto_2_3101.Extensions
@inject IHttpContextAccessor HttpContextAccessor
@{
    var usuario = HttpContextAccessor.HttpContext?.Session.GetUser();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewBag.Title - LavaCar Brillo Total</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=2" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/bootstrap-icons-1.13.1/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("HeaderSection", required: false)
</head>
<body>
<header class="p-3 mb-3 border-bottom">
        <div class="container">
          <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
            <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 link-body-emphasis text-decoration-none">
              <img src="~/images/lavacar-logo.png" alt="LavaCar Brillo Total Logo" class="navbar-logo"/>
            </a>
            <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0" >
                <li>
                    <a href="@Url.Action("Dashboard", "Home")" class="nav-link px-2 link-secondary">Dashboard</a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "User")" class="nav-link px-2 link-body-emphasis">Usuarios</a>
                </li>
                <li>
                    <a href="@Url.Action("Search", "Client")" class="nav-link px-2 link-body-emphasis">Clientes</a>
                </li>
                <li>
                    <a href="@Url.Action("Search", "Vehicle")" class="nav-link px-2 link-body-emphasis">Vehículos</a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "JobType")" class="nav-link px-2 link-body-emphasis">Servicios</a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Order")" class="nav-link px-2 link-body-emphasis">Ordenes</a>
                </li>
            </ul>
            
            <div class="dropdown text-end">
              <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="https://github.com/mdo.png" alt="mdo" width="32" height="32" class="rounded-circle" />
              </a>
              <ul class="dropdown-menu text-small">
                <li><span class="dropdown-item"><i class="bi bi-person-circle"></i> @usuario?.FullName</span></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="@Url.Action("Logout", "Home")"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a></li>
              </ul>
            </div>
          </div>
        </div>
      </header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - LavaCar Brillo Total
    </div>
</footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>